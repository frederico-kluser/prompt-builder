{
  "name": "prompt-builder-cli",
  "version": "0.1.1",
  "description": "Benchmark LLMs and evolve system prompts from the terminal. Built for coding agents: self-documenting, budget-aware, model/think-level aware.",
  "type": "module",
  "license": "MIT",
  "author": "Frederico Kluser",
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "llm",
    "benchmark",
    "prompt",
    "prompt-engineering",
    "openrouter",
    "agent",
    "agents",
    "cli",
    "evals",
    "claude-code"
  ],
  "bin": {
    "prompt-builder-cli": "dist/cli/index.js",
    "prompt-builder": "dist/cli/index.js",
    "pbuilder": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*/**/*.js",
    "dist/*/**/*.d.ts",
    "dist/arenaConfig.js",
    "dist/arenaConfig.d.ts",
    "dist/budget.js",
    "dist/budget.d.ts",
    "dist/competitor.js",
    "dist/competitor.d.ts",
    "dist/configFile.js",
    "dist/configFile.d.ts",
    "dist/contractGate.js",
    "dist/contractGate.d.ts",
    "dist/datagen.js",
    "dist/datagen.d.ts",
    "dist/dedup.js",
    "dist/dedup.d.ts",
    "dist/duels.js",
    "dist/duels.d.ts",
    "dist/estimate.js",
    "dist/estimate.d.ts",
    "dist/events.js",
    "dist/events.d.ts",
    "dist/gabarito.js",
    "dist/gabarito.d.ts",
    "dist/gatewayEnv.js",
    "dist/gatewayEnv.d.ts",
    "dist/holdout.js",
    "dist/holdout.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/jobManager.js",
    "dist/jobManager.d.ts",
    "dist/jobs.js",
    "dist/jobs.d.ts",
    "dist/judge.js",
    "dist/judge.d.ts",
    "dist/lgpd.js",
    "dist/lgpd.d.ts",
    "dist/library.js",
    "dist/library.d.ts",
    "dist/llmVariants.js",
    "dist/llmVariants.d.ts",
    "dist/medals.js",
    "dist/medals.d.ts",
    "dist/modelCaps.js",
    "dist/modelCaps.d.ts",
    "dist/modelIdsCheck.js",
    "dist/modelIdsCheck.d.ts",
    "dist/modelsCache.js",
    "dist/modelsCache.d.ts",
    "dist/normalize.js",
    "dist/normalize.d.ts",
    "dist/openrouter.js",
    "dist/openrouter.d.ts",
    "dist/orchestrator.js",
    "dist/orchestrator.d.ts",
    "dist/pathSafety.js",
    "dist/pathSafety.d.ts",
    "dist/paths.js",
    "dist/paths.d.ts",
    "dist/prepareRun.js",
    "dist/prepareRun.d.ts",
    "dist/procOwner.js",
    "dist/procOwner.d.ts",
    "dist/publicCatalog.js",
    "dist/publicCatalog.d.ts",
    "dist/rank.js",
    "dist/rank.d.ts",
    "dist/reasoning.js",
    "dist/reasoning.d.ts",
    "dist/refJudge.js",
    "dist/refJudge.d.ts",
    "dist/registry.js",
    "dist/registry.d.ts",
    "dist/roleLimits.js",
    "dist/roleLimits.d.ts",
    "dist/runArtifact.js",
    "dist/runArtifact.d.ts",
    "dist/runConfigSchema.js",
    "dist/runConfigSchema.d.ts",
    "dist/scenarioPack.js",
    "dist/scenarioPack.d.ts",
    "dist/stats.js",
    "dist/stats.d.ts",
    "dist/storage.js",
    "dist/storage.d.ts",
    "dist/techniques.js",
    "dist/techniques.d.ts",
    "dist/trainer.js",
    "dist/trainer.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "dist/variator.js",
    "dist/variator.d.ts",
    "src/data/lgpd-compliance.json",
    "src/data/lgpd-allowlist.generated.json",
    "src/data/lgpd-retention.json",
    "agent-docs",
    "skills",
    "scripts/install-agent-skill.sh"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run web:build",
    "prepublishOnly": "npm run build && npm run test:full && npm run gate:publint && npm run gate:attw && npm run gate:tarball && npm run gate:smoke",
    "setup": "npm --prefix web install",
    "cli": "tsx src/cli/index.ts",
    "dev": "concurrently -n bench,web -c blue,green \"tsx watch src/server.ts\" \"npm run web:dev\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stats:sim": "tsx scripts/stats-sim.ts",
    "lgpd:allowlist": "tsx scripts/gen-lgpd-allowlist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install",
    "gate:publint": "publint",
    "gate:attw": "attw --pack --profile esm-only",
    "gate:tarball": "node scripts/tarball-gate.mjs",
    "gate:smoke": "node scripts/tarball-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "pretest": "npm run build",
    "test:full": "PB_FULL=1 vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "playwright-core": "^1.62.1",
    "publint": "^0.3.24",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederico-kluser/prompt-builder.git"
  },
  "homepage": "https://github.com/frederico-kluser/prompt-builder#readme",
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types.d.ts"
      ]
    }
  }
}