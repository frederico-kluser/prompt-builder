# Todas as variáveis abaixo são OPCIONAIS — o app funciona sem nenhum .env.
# A chave OpenRouter NÃO vai aqui: ela é informada na própria UI (tela de setup).

# Endpoint da API OpenRouter (troque só se usar um proxy/gateway).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Headers de atribuição enviados ao OpenRouter (HTTP-Referer / X-Title).
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Prompt Builder

# Porta do servidor backend.
BENCHMARK_PORT=3001

# Interface de bind do backend (default 127.0.0.1 — só a própria máquina).
# HOST não é lido para o bind (containers/CI exportam o hostname nele).
# PB_HOST=127.0.0.1

# Nomes extras aceitos no header Host/Origin (túnel/proxy), separados por vírgula.
# Sem isso, só localhost/127.0.0.1/::1 são atendidos (proteção contra DNS rebinding).
# PB_ALLOWED_HOSTS=meu-tunel.exemplo.com
